# Proxmox Inventory - Configuration

# Port HTTP de l'interface (Nginx) exposé sur l'hôte
UI_PORT=8080

# Vérification TLS vers Proxmox : "true" pour accepter les certificats
# auto-signés (défaut), "false" pour exiger un certificat valide.
PVE_TLS_INSECURE=true

# Origine autorisée pour CORS en production (vide = permissif).
# Exemple : https://inventory.example.com
ALLOWED_ORIGIN=
